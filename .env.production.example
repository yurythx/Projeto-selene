# Copie para .env.production no servidor de produção e preencha com
# valores reais. NUNCA commitar o arquivo preenchido — só este .example.
# Usado por: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Ao contrário de .env.example (dev), aqui não há defaults fracos pra
# segredo nenhum — o compose de produção exige todos explicitamente.

# --- Porta ---
# A mesma máquina já roda o papermoon-web na porta 3000 do host — ajuste
# se 3010 também colidir com algo. Só o frontend é publicado (o backend
# fica só na rede Docker interna — arquitetura BFF).
FRONTEND_PORT=3010

# --- Postgres ---
DB_USER=selene
DB_PASSWORD=
DB_NAME=projeto_selene

# --- Redis ---
REDIS_PASSWORD=

# --- Keycloak (instância real da prefeitura — mesma pro backend e frontend) ---
KEYCLOAK_JWKS_URL=https://sso.rondonopolis.mt.gov.br/realms/rondonopolis/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://sso.rondonopolis.mt.gov.br/realms/rondonopolis
AUTH_KEYCLOAK_ISSUER=https://sso.rondonopolis.mt.gov.br/realms/rondonopolis

# Client OIDC confidencial do frontend (ver frontend/README.md, seção
# "Criando o client no Keycloak" — adicione a Valid Redirect URI de
# produção ao MESMO client já criado pro dev, não crie um novo):
# https://selene.papermoon.cloud/api/auth/callback/keycloak
AUTH_KEYCLOAK_ID=selene
AUTH_KEYCLOAK_SECRET=

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# URL pública do FRONTEND — usada só pra montar o link embutido no QR
# code do Atesto (Módulo 2 do roadmap). Vazio = o QR embute só o código
# de verificação em texto puro (ainda funcional, só sem link clicável).
PUBLIC_URL=https://selene.papermoon.cloud

# --- SMTP (opcional — vazio = notificações só em log, sem envio real) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=selene@prefeitura.gov.br

# --- Diversos (defaults geralmente OK) ---
TRUSTED_PROXIES=
LOG_LEVEL=info
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
OTEL_SERVICE_NAME=projeto-selene-backend
