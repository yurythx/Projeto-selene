# Copie este arquivo para .env e preencha os valores reais.
# Em produção, prefira injetar estas variáveis diretamente no ambiente do
# orquestrador em vez de usar um arquivo .env.

# "development" (default) ou "production". Controla o modo do Gin
# (debug/release) — SEMPRE defina como "production" em deploys reais.
APP_ENV=development

SERVER_PORT=8080

# Origens autorizadas a chamar a API pelo navegador (o frontend Next.js),
# separadas por vírgula. Vazio = nenhuma origem cross-site é permitida.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# IPs/CIDRs de proxies confiáveis (para resolver X-Forwarded-For
# corretamente atrás de um load balancer/reverse proxy), separados por
# vírgula. Vazio (default) = nenhum proxy confiável, mais seguro.
TRUSTED_PROXIES=

DB_HOST=localhost
DB_PORT=5432
DB_USER=selene
DB_PASSWORD=changeme
DB_NAME=projeto_selene
DB_SSLMODE=disable

# URL do endpoint JWKS do realm Keycloak da prefeitura, ex:
# https://keycloak.prefeitura.gov.br/realms/selene/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL=

# Valor exato esperado no claim "iss" do JWT — geralmente a URL do realm
# sem o sufixo "/protocol/openid-connect/certs", ex:
# https://keycloak.prefeitura.gov.br/realms/selene
KEYCLOAK_ISSUER=

# Valor esperado no claim "aud", se quiser validar. Vazio (default) =
# audience não é checada.
KEYCLOAK_AUDIENCE=

# Diretório local onde os documentos anexos (PDFs) são gravados
STORAGE_DIR=./storage

# SMTP para o envio assíncrono do pacote digital à empresa contratada
# (Etapa 3 do Kanban). Opcional: se SMTP_HOST ficar vazio, o envio real
# fica desabilitado e apenas registrado em log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=selene@prefeitura.gov.br

# "debug", "info" (default), "warn" ou "error".
LOG_LEVEL=info
# "json" ou "text". Default depende de APP_ENV: "json" em produção, "text"
# em desenvolvimento. Só defina para forçar um formato específico.
LOG_FORMAT=

# Limite de requisições por usuário autenticado nas rotas de escrita
# (token bucket): RATE_LIMIT_RPS requisições/segundo em regime, com rajada
# de até RATE_LIMIT_BURST.
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
