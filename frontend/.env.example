# Copie este arquivo para .env.local e preencha os valores reais.

# Chave usada pelo Auth.js para assinar/criptografar cookies de sessão.
# Gere com: openssl rand -base64 32 (ou: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# Client OIDC confidencial criado no Keycloak da prefeitura (ver
# frontend/README.md para o passo a passo de criação do client).
AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=
# URL do realm, SEM barra final, ex:
# https://sso.exemplo.gov.br/realms/nome-do-realm
AUTH_KEYCLOAK_ISSUER=

# URL do backend Go (server-only — nunca exposta ao browser). Em
# docker-compose, aponta para o serviço "backend" pela rede interna
# (ex: http://backend:8080); localmente, http://localhost:8080.
API_URL=http://localhost:8080

# Em produção (NODE_ENV=production, como na imagem Docker), o Auth.js só
# confia no header Host da requisição se isto estiver true — necessário
# sempre que o app roda atrás de mapeamento de porta/proxy reverso (ou
# seja, em qualquer deploy real). Sem isto: erro "UntrustedHost".
AUTH_TRUST_HOST=true
