# Variáveis usadas pelo docker-compose.yml da raiz (interpolação
# ${VAR} nos serviços). Copie para .env e preencha.
#
# Vars específicas de cada stack (STORAGE_DIR, RATE_LIMIT_*, etc.) têm
# seus próprios .env.example em backend/ e frontend/ — aqui só o que o
# compose usa diretamente.

# --- Keycloak (mesma instância real da prefeitura para os dois serviços) ---
# URL do JWKS do realm — usada pelo backend para validar a assinatura dos
# JWTs.
KEYCLOAK_JWKS_URL=https://sso.exemplo.gov.br/realms/nome-do-realm/protocol/openid-connect/certs
# URL do realm, SEM barra final — usada pelo backend (valida o claim "iss")
# e pelo frontend (Auth.js/Keycloak provider).
KEYCLOAK_ISSUER=https://sso.exemplo.gov.br/realms/nome-do-realm
AUTH_KEYCLOAK_ISSUER=https://sso.exemplo.gov.br/realms/nome-do-realm

# Client OIDC confidencial criado no Keycloak para o frontend (ver
# frontend/README.md para o passo a passo de criação).
AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=

# Chave do Auth.js. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
